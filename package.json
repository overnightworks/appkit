{
  "name": "overnightworks-design",
  "version": "0.31.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "src/design/static/design.css",
    "src/design/static/fonts",
    "svelte-dist",
    "!svelte-dist/**/*.test.*"
  ],
  "exports": {
    ".": {
      "types": "./svelte-dist/index.d.ts",
      "svelte": "./svelte-dist/index.js"
    },
    "./design.css": "./src/design/static/design.css",
    "./words": {
      "types": "./svelte-dist/kitWords.d.ts",
      "default": "./svelte-dist/kitWords.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "scripts": {
    "package": "svelte-package --input src/lib --output svelte-dist",
    "prepack": "pnpm run package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:consumer": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "packageManager": "pnpm@10.32.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24 || ^26"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/coverage-v8": "~5.1.0",
    "jsdom": "30.1.3",
    "pyright": "1.1.414",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "deepmerge": "-"
    },
    "patchedDependencies": {
      "@sveltejs/vite-plugin-svelte@7.3.1": "patches/@sveltejs__vite-plugin-svelte@7.3.1.patch"
    }
  }
}
