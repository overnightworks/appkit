{
  "name": "overnightworks-appkit",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "src/appkit/static/appkit.css",
    "src/appkit/static/fonts",
    "svelte-dist",
    "!svelte-dist/**/*.test.*"
  ],
  "exports": {
    ".": {
      "types": "./svelte-dist/index.d.ts",
      "svelte": "./svelte-dist/index.js"
    },
    "./appkit.css": "./src/appkit/static/appkit.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "scripts": {
    "package": "svelte-package --input src/lib --output svelte-dist",
    "prepack": "pnpm run package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:consumer": "playwright test --config tests/consumer/playwright.config.ts"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "jsdom": "30.0.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "deepmerge": "-"
    },
    "patchedDependencies": {
      "@sveltejs/vite-plugin-svelte@7.3.1": "patches/@sveltejs__vite-plugin-svelte@7.3.1.patch"
    }
  }
}
